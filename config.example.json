{
  "$comment": "Every key is optional and documented in docs/configuration.md. Templates accept {number} {ref} {source} {title} {slug} {url} {repo} {owner} {name} {branch} {label} {agent} {author} {labels} {vcs_branch}. The Shortcut and Linear API tokens never go here: the Shortcut and Linear tabs of the popup ask for them. `,` in the issues popup edits tabs, agent and agent_args for you.",
  "tabs": [
    "all",
    "github",
    "shortcut",
    "linear"
  ],
  "agent": "auto",
  "agent_args": {},
  "agent_modes": {
    "claude": {
      "accept edits": [
        "--permission-mode",
        "acceptEdits"
      ],
      "auto": [
        "--permission-mode",
        "auto"
      ],
      "plan": [
        "--permission-mode",
        "plan"
      ],
      "skip permissions (dangerous)": [
        "--dangerously-skip-permissions"
      ]
    },
    "codex": {
      "read only": [
        "--sandbox",
        "read-only"
      ],
      "workspace write": [
        "--sandbox",
        "workspace-write"
      ],
      "no sandbox, no approvals (dangerous)": [
        "--dangerously-bypass-approvals-and-sandbox"
      ]
    },
    "gemini": {
      "auto edit": [
        "--approval-mode",
        "auto_edit"
      ],
      "yolo (dangerous)": [
        "--yolo"
      ]
    }
  },
  "agent_name": "issue-{number}",
  "branch": "issue-{number}-{slug}",
  "base": "",
  "label": "{ref} {title}",
  "label_max": 40,
  "slug_max": 40,
  "prompt": "{url}",
  "submit": false,
  "focus": true,
  "trust_repository": false,
  "auto_accept_trust_prompt": true,
  "trust_prompt_pattern": "trust the files|trust this (folder|directory|workspace|repository)|do you trust|yes, proceed",
  "notify": true,
  "workspace_token": true,
  "limit": 100,
  "shortcut": {
    "team": "",
    "query": "!is:done !is:archived",
    "branch": "sc-{number}-{slug}",
    "agent_name": "sc-{number}"
  },
  "linear": {
    "team": "",
    "filter": {},
    "branch": "{ref}-{slug}",
    "agent_name": "{ref}"
  },
  "timeouts": {
    "worktree_ms": 180000,
    "agent_start_ms": 90000,
    "agent_ready_ms": 20000,
    "prompt_ms": 30000,
    "submit_check_ms": 6000,
    "retry_ms": 1000
  }
}
