{
  "name": "herdr-issues",
  "version": "0.1.0",
  "private": true,
  "description": "herdr plugin: browse GitHub issues, Shortcut stories and Linear issues in a popup and hand one to any coding agent in its own git worktree",
  "type": "module",
  "license": "MIT",
  "author": "Sergio Zamarro (https://github.com/zamarrowski)",
  "repository": {
    "type": "git",
    "url": "https://github.com/zamarrowski/herdr-issues.git"
  },
  "homepage": "https://github.com/zamarrowski/herdr-issues#readme",
  "bugs": "https://github.com/zamarrowski/herdr-issues/issues",
  "keywords": [
    "herdr",
    "herdr-plugin",
    "github",
    "issues",
    "shortcut",
    "linear",
    "worktree",
    "coding-agent",
    "claude-code",
    "codex",
    "gemini-cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check lib/*.mjs scripts/*.mjs test/*.mjs test/fixtures/*.mjs tools/screenshots/*.mjs",
    "issues": "sh bin/run.sh scripts/issues.mjs",
    "start-issue": "sh bin/run.sh scripts/start.mjs",
    "setup": "sh bin/run.sh scripts/setup.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0"
  }
}
